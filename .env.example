# Copy to .env and fill in what you use. All of it is optional: the app runs
# without any of these, and the arms that need them stay quiet.

# Where your database lives, relative to this directory. The default is fine.
# DATABASE_URL=file:./belay.db

# If set, inference goes through the Anthropic API. If not, the app shells out to
# the `claude` CLI on this machine instead.
# ANTHROPIC_API_KEY=

# --- Search filters -------------------------------------------------------------
# Every one of these is off by default, so a fresh install shows you everything and
# lets you narrow it. A filter you chose is useful; a filter you inherited from
# someone else's career is a mystery. See lib/search-config.ts.

# Minimum pay for a role to enter the queue, checked against the top of a stated
# band. Leave unset for no floor: most postings state no band at all.
# SEARCH_COMP_FLOOR_USD=160000

# A posting asking for more years than this is a different job, not a stretch.
# SEARCH_MAX_YOE=10

# How old a posting can be when it is scanned. Nothing already in your queue ages out.
# SEARCH_MAX_POSTING_AGE_DAYS=14

# Seniority words that put a role out of reach for you. Comma separated.
# SEARCH_LEVEL_EXCLUDE=principal,director,head of,vice president,intern,new grad

# Titles to drop everywhere, whatever else they offer.
# SEARCH_TITLE_EXCLUDE=

# Companies where senior-and-above is a different ladder rung than yours.
# SEARCH_COMPANY_LEVEL_EXCLUDE=

# Places you cannot work. Comma separated, matched against the location string.
# SEARCH_LOCATION_EXCLUDE=

# --- Optional ingest arms -------------------------------------------------------
# Pasted from a logged-in browser session. Only the LinkedIn arm uses it.
# LINKEDIN_COOKIE=
# GOOGLE_CREDENTIALS_PATH=./credentials.json
# GMAIL_TOKEN_PATH=./gmail_token.json
